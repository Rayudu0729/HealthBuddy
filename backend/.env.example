# Copy to .env for local development. Never commit .env or real credentials.
PORT=3000
DATABASE_URL=postgres://bindu:bindu@localhost:5432/bindu
SESSION_SECRET=change-me-to-a-long-random-string
DASHBOARD_ORIGIN=http://localhost:5173
# httpSMS (leave empty to use the fake adapter that only logs)
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# Caregiver phone (E.164). Empty = no SMS is queued (sms status "none")
CAREGIVER_SMS_TO=
# Seed (optional)
# SEED_CAREGIVER_EMAIL=demo@bindu.local
# SEED_CAREGIVER_PASSWORD=bindu-demo-123
